<Window x:Class="MemoryStudio.MemoryAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Studio · 地址分析" Width="1140" Height="800" MinWidth="620" MinHeight="450"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="ReportText" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" /></Border></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{DynamicResource SurfaceBrush}" CornerRadius="7,7,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,6,0"><ContentPresenter ContentSource="Header" /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="AppearanceRoot" Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="地址分析与证据导出" FontSize="23" FontWeight="SemiBold" FontFamily="{DynamicResource HeadingFontFamily}" />
            <TextBlock Text="离线整理当前数据、指令上下文和已捕获来源。复制提示后可自行交给 AI 解释。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="TargetLabel" Text="正在读取目标…" FontFamily="Consolas" TextWrapping="Wrap" />
                <TextBlock x:Name="ValueLabel" Text="正在读取当前值与附近字节…" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock x:Name="EvidenceLabel" Text="数据旁的解码不能证明访问来源；实际来源以追踪捕获为依据。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                <WrapPanel Margin="0,14,0,0">
                    <Button x:Name="CopyPromptButton" Content="复制给 AI 的提示" Style="{DynamicResource PrimaryButton}" Click="CopyPromptButton_Click" Margin="0,0,8,6" />
                    <Button x:Name="CopyReportButton" Content="复制报告" Click="CopyReportButton_Click" Margin="0,0,8,6" />
                    <Button x:Name="ExportButton" Content="导出 Markdown / JSON" Click="ExportButton_Click" Margin="0,0,8,6" />
                    <Button x:Name="RefreshButton" Content="更新快照" Click="RefreshButton_Click" Margin="0,0,0,6" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <TabControl Grid.Row="2" x:Name="ReportTabs" SelectedIndex="0" Background="Transparent" BorderThickness="0" Padding="0,10,0,0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TabPanel IsItemsHost="True" Background="Transparent" />
                        <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0,10,0,0" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="分析报告"><TextBox x:Name="ReportText" Style="{StaticResource ReportText}" AutomationProperties.Name="地址分析报告" /></TabItem>
            <TabItem Header="指令上下文">
                <DataGrid x:Name="CodeGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False" SelectionMode="Single" RowHeight="31" ColumnHeaderHeight="34" AutomationProperties.Name="分析指令上下文">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="180" ElementStyle="{DynamicResource AddressCell}" />
                        <DataGridTextColumn Header="机器码" Binding="{Binding BytesHex}" Width="175" ElementStyle="{DynamicResource AddressCell}" />
                        <DataGridTextColumn Header="Intel 指令" Binding="{Binding Instruction}" Width="*" MinWidth="230" />
                        <DataGridTextColumn Header="简要作用" Binding="{Binding Explanation}" Width="300" />
                        <DataGridTextColumn Header="边界依据" Binding="{Binding Boundary}" Width="210" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="给 AI 的提示"><TextBox x:Name="PromptText" Style="{StaticResource ReportText}" AutomationProperties.Name="AI 分析提示" /></TabItem>
            <TabItem Header="JSON"><TextBox x:Name="JsonText" Style="{StaticResource ReportText}" AutomationProperties.Name="地址分析 JSON" /></TabItem>
        </TabControl>
        <TextBlock Grid.Row="3" x:Name="StatusLabel" Text="只在本机读取并生成报告。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
    </Grid>
</Window>
