<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>MemoryStudio</AssemblyName>
    <RootNamespace>MemoryStudio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.4.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\artifacts\native\memory_core.dll" Condition="Exists('..\artifacts\native\memory_core.dll')" Link="memory_core.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\artifacts\native\DemoTarget.exe" Condition="Exists('..\artifacts\native\DemoTarget.exe')" LogicalName="MemoryStudio.Assets.DemoTarget.exe" />
    <EmbeddedResource Include="..\artifacts\native\nasm.exe" Condition="Exists('..\artifacts\native\nasm.exe')" LogicalName="MemoryStudio.Assets.nasm.exe" />
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="Assets\ThirdPartyNotices.txt" LogicalName="MemoryStudio.Assets.ThirdPartyNotices.txt" />
    <PackageReference Include="Iced" Version="1.21.0" />
  </ItemGroup>
</Project>
