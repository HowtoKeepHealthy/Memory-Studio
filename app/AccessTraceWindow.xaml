<Window x:Class="MemoryStudio.AccessTraceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Studio · 地址访问来源" Width="1230" Height="790" MinWidth="1080" MinHeight="660"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="TraceCodeCell" TargetType="TextBlock" BasedOn="{StaticResource AddressCell}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </Window.Resources>
    <Grid Margin="22,20,22,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="68" /><RowDefinition Height="Auto" /><RowDefinition Height="58" />
            <RowDefinition Height="*" /><RowDefinition Height="158" /><RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock x:Name="HeadingLabel" Text="查找地址访问来源" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="TargetLabel" Style="{StaticResource MutedText}" FontFamily="Consolas" Margin="0,7,0,0" /></StackPanel>
            <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="5" Padding="12,6" VerticalAlignment="Top" Margin="0,4,0,0">
                <TextBlock Text="LIVE / DEBUGGER" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="11" />
            </Border>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="15,12" Margin="0,0,0,12">
            <TextBlock Text="点击开始后会调试附加目标，并临时监控地址所在内存页，目标速度可能降低。停止或关闭会恢复页面保护并解除附加。命中按实际操作数范围筛选；列表计数表示捕获次数，多线程和高频访问可能有遗漏。"
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="20" />
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="StartButton" Content="开始追踪" Style="{StaticResource PrimaryButton}" Click="StartButton_Click" />
            <Button Grid.Column="1" x:Name="StopButton" Content="停止并保留结果" Click="StopButton_Click" IsEnabled="False" Margin="9,0,0,0" />
            <Button Grid.Column="2" x:Name="ClearButton" Content="清空结果" Click="ClearButton_Click" Margin="9,0,0,0" />
            <TextBlock Grid.Column="3" x:Name="StatisticsLabel" Text="尚未开始" Style="{StaticResource MutedText}" FontSize="11" Margin="16,0,0,0" />
            <Button Grid.Column="4" Content="复制选中" Style="{StaticResource GhostButton}" Click="CopyButton_Click" />
        </Grid>
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <DataGrid x:Name="HitGrid" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                      RowHeight="32" ColumnHeaderHeight="36" CanUserReorderColumns="False"
                      SelectionChanged="HitGrid_SelectionChanged" AutomationProperties.Name="捕获的地址访问指令">
                <DataGrid.ContextMenu><ContextMenu><MenuItem Header="复制指令与访问范围" Click="CopyButton_Click" /></ContextMenu></DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="指令地址" Binding="{Binding AddressText}" Width="170" ElementStyle="{StaticResource AddressCell}" />
                    <DataGridTextColumn Header="机器码" Binding="{Binding BytesText}" Width="195" ElementStyle="{StaticResource TraceCodeCell}" />
                    <DataGridTextColumn Header="Intel 指令" Binding="{Binding Instruction}" Width="*" MinWidth="230" ElementStyle="{StaticResource TraceCodeCell}" />
                    <DataGridTextColumn Header="访问" Binding="{Binding AccessText}" Width="95" />
                    <DataGridTextColumn Header="线程 ID" Binding="{Binding ThreadText}" Width="86" />
                    <DataGridTextColumn Header="捕获次数" Binding="{Binding CountText}" SortMemberPath="Count" Width="94" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock x:Name="DetailLabel" Text="选择一条指令，查看最后一次触发时执行前的寄存器快照。" Style="{StaticResource MutedText}" FontSize="11" />
                <TextBox Grid.Row="1" x:Name="RegistersText" IsReadOnly="True" BorderThickness="0" Background="Transparent" MinHeight="0" Padding="0,8,0,0"
                         FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>
        <TextBlock Grid.Row="5" x:Name="StatusLabel" Text="尚未附加。按开始后，在目标程序中触发相关数值读取或改变。" Style="{StaticResource MutedText}" FontSize="11"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Grid>
</Window>
