                                <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,0"><TextBlock Text="当前使用绝对地址，目标进程重启后地址可能变化。" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" /></Border>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="17,13" Margin="0,12,0,0">
                            <WrapPanel><StackPanel Margin="0,0,22,10"><TextBlock Text="写入所有选中地址" Style="{StaticResource SectionTitle}" /><TextBlock Text="输入对应类型的新值；写入会同步更新冻结值。" Style="{StaticResource MutedText}" Margin="0,5,0,0" FontSize="11" /></StackPanel><TextBox Text="{Binding EditValueText, UpdateSourceTrigger=PropertyChanged}" Width="150" FontFamily="Consolas" FontSize="14" Margin="0,0,8,0" /><Button Content="写入所选" Click="WriteFullSelected_Click" Style="{StaticResource BusyPrimaryButton}" Margin="0,0,8,0" /><Button Content="移除所选" Click="RemoveFullSelected_Click" Style="{StaticResource BusyCompactButton}" /></WrapPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="关于">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="820" Margin="20,24" HorizontalAlignment="Center"><Border Width="68" Height="68" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left" Margin="0,0,0,22"><Path Data="M 3,4 L 3,20 M 9,8 L 9,16 M 15,2 L 15,22 M 21,7 L 21,17" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="33" Height="33" /></Border><TextBlock Text="让内存里的变化，更清晰。" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" /><TextBlock Text="Memory Studio 是一个 Windows 进程内存工作台。通过扫描、逐次筛选和实时监视，找到程序中变化的数值，并观察修改后的行为。" Style="{StaticResource MutedText}" FontSize="14" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,24" /><Border Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="从练习进程开始" Style="{StaticResource SectionTitle}" /><TextBlock Text="启动目标，输入其当前数值扫描，改变数值后再次筛选。多选结果后双击数值或类型列，会统一编辑整组选中的记录。" Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="22" Margin="0,9,0,16" /><Button Content="启动练习进程 ↗" Command="{Binding LaunchDemoCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" /></StackPanel></Border><TextBlock Text="工具菜单提供显示缩放与字体设置、手动地址、指针和结构工具。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,22,0,0" /><TextBlock Text="C++20 扫描核心  /  C# · WPF 界面  /  Windows x64" Style="{StaticResource MutedText}" FontSize="11" Margin="0,15,0,0" /><TextBlock Text="用于你有权调试的本机程序。部分受保护进程无法连接。" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" /></StackPanel></ScrollViewer>
