                        <WrapPanel Margin="2,0,2,14"><StackPanel Margin="0,0,20,8"><TextBlock Text="地址表" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="多选后双击批量编辑；冻结和暂停均可恢复" Style="{StaticResource MutedText}" Margin="0,4,0,0" /></StackPanel><Button Content="新增地址" Command="{Binding AddManualAddressCommand}" Margin="0,5,8,0" /><Button Content="导入" Command="{Binding LoadTableCommand}" Margin="0,5,8,0" /><Button Content="保存" Command="{Binding SaveTableCommand}" Style="{StaticResource PrimaryButton}" Margin="0,5,0,0" /></WrapPanel>
