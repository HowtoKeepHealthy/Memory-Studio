<Window x:Class="MemoryStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Studio · 进程内存工作台" Width="1280" Height="820"
        MinWidth="780" MinHeight="520" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="IdlePanel" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EmptyResults" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding Results.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="EmptyWatches" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding Watches.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="RecordContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrongLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="MinWidth" Value="230" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" /></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="RecordMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="CheckGlyph" Text="✓" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" FontSize="13" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="20,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecordMenuSeparator" TargetType="Separator">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource LineBrush}" Margin="9,5" /></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="RecordMenuTitle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border Padding="12,7"><TextBlock Text="{TemplateBinding Header}" Foreground="{DynamicResource MutedBrush}" FontSize="11" /></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FreezeCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Style.Triggers><DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="BusyCompactButton" TargetType="Button" BasedOn="{StaticResource CompactButton}">
            <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger><DataTrigger Binding="{Binding IsAttached}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="BusyPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger><DataTrigger Binding="{Binding IsAttached}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="FreezeCell">
            <CheckBox IsChecked="{Binding IsFrozen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FreezeCheckBox}" HorizontalAlignment="Center" ToolTip="单击切换冻结；双击编辑冻结数值" />
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="MainShell" SizeChanged="MainShell_SizeChanged">
        <Grid.RowDefinitions><RowDefinition x:Name="MainHeaderRow" Height="86" /><RowDefinition Height="*" /><RowDefinition Height="34" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.RowSpan="3" Background="{DynamicResource NavBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition x:Name="RailBrandRow" Height="86" /><RowDefinition Height="*" /><RowDefinition Height="88" /></Grid.RowDefinitions>
                <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                    <Path Data="M 3,4 L 3,20 M 9,8 L 9,16 M 15,2 L 15,22 M 21,7 L 21,17" Stroke="{DynamicResource AccentOnBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="22" Height="22" />
                </Border>
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <ToggleButton x:Name="ScanNavigation" Style="{StaticResource NavigationButton}" IsChecked="True" Click="ScanNavigation_Click" ToolTip="扫描工作台">
                        <StackPanel><Path Data="M 2,7 L 2,2 L 7,2 M 15,2 L 20,2 L 20,7 M 20,15 L 20,20 L 15,20 M 7,20 L 2,20 L 2,15 M 6,11 L 16,11 M 11,6 L 11,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7" Width="21" Height="21" Stretch="Uniform" /><TextBlock x:Name="NavScanLabel" Text="扫描" FontSize="11" Margin="0,7,0,0" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /></StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="WatchNavigation" Style="{StaticResource NavigationButton}" Click="WatchNavigation_Click" ToolTip="地址表">
                        <StackPanel><Path Data="M 2,3 L 20,3 L 20,19 L 2,19 Z M 2,8 L 20,8 M 7,3 L 7,19 M 7,13 L 20,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6" Width="21" Height="21" Stretch="Uniform" /><TextBlock x:Name="NavWatchLabel" Text="地址表" FontSize="11" Margin="0,7,0,0" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /></StackPanel>
                    </ToggleButton>
                </StackPanel>
                <ToggleButton Grid.Row="2" x:Name="AboutNavigation" Style="{StaticResource NavigationButton}" Click="AboutNavigation_Click" VerticalAlignment="Center" ToolTip="关于 Memory Studio">
                    <StackPanel><Grid Width="21" Height="21"><Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6" /><TextBlock Text="i" FontFamily="Georgia" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-1,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /></Grid><TextBlock x:Name="NavAboutLabel" Text="关于" FontSize="11" Margin="0,7,0,0" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /></StackPanel>
                </ToggleButton>
            </Grid>
        </Border>
        <Border Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource HeaderBrush}">
            <Grid x:Name="HeaderLayout" Margin="20,0">
                <Grid.RowDefinitions><RowDefinition x:Name="HeaderFirstRow" Height="*" /><RowDefinition x:Name="HeaderSecondRow" Height="0" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel x:Name="BrandHeader" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Memory" FontSize="23" FontWeight="SemiBold" FontFamily="Segoe UI" /><TextBlock Text="Studio" FontSize="23" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource AccentBrush}" Margin="6,0,0,0" /><Border Background="{DynamicResource BadgeBrush}" CornerRadius="4" Margin="12,3,0,0" Padding="6,2" VerticalAlignment="Center"><TextBlock Text="x64" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BadgeTextBrush}" /></Border></StackPanel>
                    <TextBlock x:Name="BrandSubtitle" Text="进程内存工作台" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                </StackPanel>
                <WrapPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="ProcessActions" Orientation="Horizontal" Style="{StaticResource IdlePanel}">
                        <Button x:Name="PickerButton" Width="36" Padding="7" Margin="0,0,7,0" PreviewMouseLeftButtonDown="PickerButton_MouseDown" PreviewMouseLeftButtonUp="PickerButton_MouseUp" LostMouseCapture="PickerButton_LostMouseCapture" ToolTip="按住准星拖到目标窗口，释放以连接；Esc 取消" AutomationProperties.Name="拖动准星选取目标窗口"><Grid Width="20" Height="20"><Ellipse Width="13" Height="13" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" /><Path Data="M 10,0 L 10,6 M 10,14 L 10,20 M 0,10 L 6,10 M 14,10 L 20,10" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" /></Grid></Button>
                        <ComboBox x:Name="ProcessCombo" Width="225" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" DisplayMemberPath="DisplayName" ToolTip="目标进程" AutomationProperties.Name="目标进程" />
                        <Button Command="{Binding RefreshProcessesCommand}" Width="36" Padding="7" Margin="7,0,0,0" ToolTip="刷新进程列表"><Path Data="M 17,7 A 7,7 0 1 0 18,13 M 17,2 L 17,7 L 12,7" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform" /></Button>
                        <Button Content="连接进程" Command="{Binding AttachCommand}" Style="{StaticResource PrimaryButton}" Margin="7,0,0,0" Padding="12,8" />
                    </StackPanel>
                    <Button Content="工具 ▾" Click="ToolsButton_Click" Margin="7,0,0,0" Padding="10,8" ToolTip="手动添加、撤销、指针与结构工具、显示设置" />
                </WrapPanel>
            </Grid>
        </Border>
        <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Grid.Column="1" Margin="16,14,16,10" SelectedIndex="0">
            <TabItem Header="扫描">
                <ScrollViewer x:Name="ScanPageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" ScrollChanged="ResultGrid_ScrollChanged">
                    <Grid x:Name="ScanPageLayout" MinWidth="700">
                        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="2,0,2,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="扫描工作台" FontFamily="{DynamicResource HeadingFontFamily}" FontSize="20" FontWeight="SemiBold" /><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Margin="12,0,0,0" Padding="9,5" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Margin="0,0,6,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsAttached}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock x:Name="ProcessBadgeText" Text="{Binding ProcessLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" MaxWidth="280" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessLabel}" /></StackPanel></Border></StackPanel>
                            <Button x:Name="PracticeButton" Grid.Column="1" Command="{Binding LaunchDemoCommand}" Style="{StaticResource GhostButton}" Content="启动练习 ↗" FontSize="11" Padding="7,6" ToolTip="启动内置练习进程" />
                        </Grid>
                        <Grid Grid.Row="1" x:Name="ScanLayout">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ScanSettingsColumn" Width="260" /><ColumnDefinition x:Name="ScanGapColumn" Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="ResultsCard" Grid.Column="2" Style="{StaticResource Card}" Height="370">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="59" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid Margin="17,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="扫描结果" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding ResultSummary}" Style="{StaticResource MutedText}" Margin="0,4,0,0" /></StackPanel><Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="{Binding ElapsedText}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource AccentBrush}" /></Border></Grid>
                                    <Grid Grid.Row="1">
                                        <DataGrid x:Name="ResultGrid" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
                                                  PreviewMouseRightButtonDown="RecordGrid_MouseRightButtonDown" PreviewMouseLeftButtonDown="RecordGrid_MouseLeftButtonDown" PreviewKeyDown="RecordGrid_PreviewKeyDown"
                                                  Loaded="ResultGrid_Loaded" ScrollViewer.ScrollChanged="ResultGrid_ScrollChanged"
                                                  ToolTip="Ctrl/Shift 多选；Ctrl+A 全选全部扫描结果；双击已选行按列批量编辑；右键更多操作" AutomationProperties.Name="扫描结果">
                                            <DataGrid.Columns><DataGridTextColumn Header="内存地址" Binding="{Binding AddressText}" Width="1.25*" MinWidth="145" ElementStyle="{StaticResource AddressCell}" /><DataGridTextColumn Header="当前数值" Binding="{Binding ValueText}" Width="1.4*" MinWidth="110" ElementStyle="{StaticResource ValueCell}" /><DataGridTextColumn Header="类型" Binding="{Binding TypeLabel}" Width="0.8*" MinWidth="75" /></DataGrid.Columns>
                                        </DataGrid>
                                        <StackPanel Style="{StaticResource EmptyResults}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="12,25,12,5"><Grid Width="45" Height="45" Margin="0,0,0,11"><Border Background="{DynamicResource BadgeBrush}" CornerRadius="14" /><Path Data="M 1,7 L 1,1 L 7,1 M 17,1 L 23,1 L 23,7 M 23,17 L 23,23 L 17,23 M 7,23 L 1,23 L 1,17 M 8,12 L 16,12" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6" Width="23" Height="23" Stretch="Uniform" /></Grid><TextBlock Text="从一个数值开始" HorizontalAlignment="Center" FontSize="15" /><TextBlock Text="连接进程，设置条件后开始扫描" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,7,0,0" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel>
                                    </Grid>
                                    <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                                        <WrapPanel Margin="11,6" VerticalAlignment="Center">
                                            <Button Content="‹" Command="{Binding PreviousPageCommand}" Style="{StaticResource CompactButton}" Width="27" Padding="0" ToolTip="上一页" /><TextBlock Text="{Binding PageLabel}" Style="{StaticResource MutedText}" Margin="8,0" /><Button Content="›" Command="{Binding NextPageCommand}" Style="{StaticResource CompactButton}" Width="27" Padding="0" ToolTip="下一页" />
                                            <Button Content="本页" Click="SelectAllResults_Click" Style="{StaticResource GhostButton}" FontSize="11" Padding="8,5" MinHeight="30" Margin="4,0" ToolTip="全选本页" /><Button Content="全选" Click="SelectAllScanResults_Click" Style="{StaticResource GhostButton}" FontSize="11" Padding="8,5" MinHeight="30" ToolTip="Ctrl+A；全选全部扫描结果（跨页）" />
                                            <Button Content="反汇编" Command="{Binding OpenDisassemblyCommand}" Style="{StaticResource CompactButton}" Margin="8,0,5,0" /><Button Content="内存查看" Command="{Binding OpenMemoryViewerCommand}" Style="{StaticResource CompactButton}" Margin="0,0,5,0" /><Button Content="＋ 添加所选" Click="AddSelectedResults_Click" Style="{StaticResource BusyCompactButton}" ToolTip="将所有选中结果加入地址表" />
                                        </WrapPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border x:Name="ScanSettingsCard" Style="{StaticResource Card}" Height="370">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="43" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Button x:Name="ScanSettingsToggle" Content="扫描设置" Click="ScanSettingsToggle_Click" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Padding="17,8" ToolTip="展开或折叠扫描条件" />
                                    <ScrollViewer x:Name="ScanSettingsFields" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Style="{StaticResource IdlePanel}" Margin="17,0,17,12">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="数据类型" Style="{StaticResource MutedText}" FontSize="11" /><ComboBox Grid.Column="1" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Label" MinHeight="36" FontSize="12" /></Grid>
                                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="扫描方式" Style="{StaticResource MutedText}" FontSize="11" /><ComboBox Grid.Column="1" ItemsSource="{Binding ScanModes}" SelectedItem="{Binding SelectedScanMode}" DisplayMemberPath="Label" MinHeight="36" FontSize="12" /></Grid>
                                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="扫描数值" Style="{StaticResource MutedText}" FontSize="11" /><TextBox x:Name="SearchValueInput" Grid.Column="1" IsEnabled="{Binding SearchValueEnabled}" Text="{Binding SearchValue, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" FontFamily="Consolas" FontSize="14" ToolTip="精确值、比较下限或增加/减少的差量；未知初始值等方式不需要输入" /></Grid>
                                            <Grid Margin="0,6,0,0"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedScanMode.Value}" Value="8"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="范围上限" Style="{StaticResource MutedText}" FontSize="11" /><TextBox x:Name="SearchUpperInput" Grid.Column="1" IsEnabled="{Binding SearchUpperEnabled}" Text="{Binding SearchUpperValue, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" FontFamily="Consolas" FontSize="14" /></Grid>
                                            <WrapPanel Margin="0,13,0,0"><CheckBox Content="类型对齐" IsChecked="{Binding AlignmentEnabled}" FontSize="11" Margin="0,0,12,7" /><CheckBox Content="可写内存" IsChecked="{Binding WritableOnly}" FontSize="11" Margin="0,0,0,7" /></WrapPanel>
                                            <CheckBox Content="十六进制显示 / 输入" IsChecked="{Binding HexDisplayEnabled}" FontSize="11" Margin="0,2,0,0" ToolTip="整数显示十六进制；浮点数显示其 IEEE 原始位模式" />
                                            <Expander Header="浮点比较容差" Margin="0,13,0,0" FontSize="11"><StackPanel Margin="0,9,0,0"><CheckBox Content="启用近似比较" IsChecked="{Binding FloatToleranceEnabled}" FontSize="11" Margin="0,0,0,9" /><TextBlock Text="绝对容差" Style="{StaticResource FieldLabel}" FontSize="10" /><TextBox Text="{Binding FloatToleranceText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" MinHeight="32" Padding="9,6" /><TextBlock Text="相对容差" Style="{StaticResource FieldLabel}" FontSize="10" Margin="0,8,0,7" /><TextBox Text="{Binding RelativeToleranceText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" MinHeight="32" Padding="9,6" /></StackPanel></Expander>
                                            <Expander Header="限定地址范围" Margin="0,12,0,0" FontSize="11"><StackPanel Margin="0,9,0,0"><TextBlock Text="起始地址（十六进制）" Style="{StaticResource FieldLabel}" FontSize="10" /><TextBox Text="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" MinHeight="32" Padding="9,6" /><TextBlock Text="结束地址（包含）" Style="{StaticResource FieldLabel}" FontSize="10" Margin="0,8,0,7" /><TextBox Text="{Binding EndAddress, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" MinHeight="32" Padding="9,6" ToolTip="结束地址包含在扫描范围内；输入十六进制地址" /></StackPanel></Expander>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="17,10,17,7">
                                        <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Content="首次扫描" Command="{Binding FirstScanCommand}" Style="{StaticResource PrimaryButton}" Padding="8,8" /><Button Grid.Column="2" Content="再次筛选" Command="{Binding NextScanCommand}" Padding="8,8" /></Grid><WrapPanel Margin="0,4,0,0" HorizontalAlignment="Center"><Button Content="重置" Command="{Binding NewScanCommand}" Style="{StaticResource GhostButton}" FontSize="11" Padding="7,4" MinHeight="26" /><Button Content="停止" Command="{Binding CancelScanCommand}" Style="{StaticResource GhostButton}" FontSize="11" Padding="7,4" MinHeight="26" /><Button Content="撤销扫描" Command="{Binding UndoScanCommand}" Style="{StaticResource GhostButton}" FontSize="11" Padding="7,4" MinHeight="26" /></WrapPanel><ProgressBar Value="{Binding ScanProgress, Mode=OneWay}" Margin="0,4,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" /></StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                        <Border x:Name="CompactWatchCard" Grid.Row="3" Style="{StaticResource Card}" Height="200">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <WrapPanel Margin="14,5"><TextBlock Text="地址表" Style="{StaticResource SectionTitle}" Margin="0,0,12,0" /><Button Content="新增地址" Command="{Binding AddManualAddressCommand}" Style="{StaticResource GhostButton}" FontSize="11" /><Button Content="全选" Click="SelectAllCompactWatch_Click" Style="{StaticResource GhostButton}" FontSize="11" /><Button Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}" Style="{StaticResource GhostButton}" FontSize="11" /><Button Content="撤销所选" Click="UndoSelectedRecords_Click" ToolTip="所选的每条记录各自撤销最近一次编辑" Style="{StaticResource GhostButton}" FontSize="11" /><Button Content="导入" Command="{Binding LoadTableCommand}" Style="{StaticResource GhostButton}" FontSize="11" /><Button Content="保存" Command="{Binding SaveTableCommand}" Style="{StaticResource GhostButton}" FontSize="11" /></WrapPanel>
                                <Grid Grid.Row="1"><DataGrid x:Name="CompactWatchGrid" ItemsSource="{Binding Watches}" SelectedItem="{Binding SelectedWatch}" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" PreviewMouseRightButtonDown="RecordGrid_MouseRightButtonDown" PreviewMouseLeftButtonDown="RecordGrid_MouseLeftButtonDown" PreviewKeyDown="RecordGrid_PreviewKeyDown" ToolTip="Ctrl/Shift 多选；双击已选行按列批量编辑；冻结框单击切换，双击批量编辑数值" AutomationProperties.Name="监视地址表"><DataGrid.Columns><DataGridTemplateColumn Header="冻结" Width="56" CellTemplate="{StaticResource FreezeCell}" /><DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="1.35*" MinWidth="90" /><DataGridTextColumn Header="内存地址" Binding="{Binding AddressText}" Width="1.2*" MinWidth="145" ElementStyle="{StaticResource AddressCell}" /><DataGridTextColumn Header="当前数值" Binding="{Binding ValueText}" Width="1.2*" MinWidth="100" ElementStyle="{StaticResource ValueCell}" /><DataGridTextColumn Header="类型" Binding="{Binding TypeLabel}" Width="0.8*" MinWidth="75" /></DataGrid.Columns></DataGrid><StackPanel Style="{StaticResource EmptyWatches}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,24,0,0"><TextBlock Text="添加扫描结果或手动输入监视地址" Style="{StaticResource MutedText}" FontSize="11" /></StackPanel></Grid>
                                <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"><WrapPanel Margin="12,6" VerticalAlignment="Center"><TextBlock Text="{Binding Watches.Count, StringFormat=已记录 {0} 个地址}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,14,0" /><TextBox Text="{Binding EditValueText, UpdateSourceTrigger=PropertyChanged}" Width="130" MinHeight="30" Padding="8,4" FontFamily="Consolas" FontSize="12" ToolTip="写入所有选中监视地址的新值" /><Button Content="写入所选" Click="WriteCompactSelected_Click" Style="{StaticResource BusyCompactButton}" Margin="7,0,0,0" /><Button Content="移除所选" Click="RemoveCompactSelected_Click" Style="{StaticResource BusyCompactButton}" Margin="7,0,0,0" /></WrapPanel></Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="地址表">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
