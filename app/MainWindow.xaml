                                <WrapPanel Margin="14,5"><TextBlock Text="监视列表" Style="{StaticResource SectionTitle}" Margin="0,0,14,0" /><Button Content="全选全部" Click="SelectAllFullWatch_Click" Style="{StaticResource GhostButton}" FontSize="11" /><Button Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}" Style="{StaticResource GhostButton}" FontSize="11" /><Button Content="撤销所选" Click="UndoSelectedRecords_Click" ToolTip="所选的每条记录各自撤销最近一次编辑" Style="{StaticResource GhostButton}" FontSize="11" /><TextBlock Text="{Binding Watches.Count, StringFormat={}{0} 个地址}" Style="{StaticResource MutedText}" Margin="12,0,0,0" /></WrapPanel>
