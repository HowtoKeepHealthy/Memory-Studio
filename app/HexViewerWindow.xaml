<Window x:Class="MemoryStudio.HexViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Studio · 内存查看器" Width="1040" Height="720" MinWidth="880" MinHeight="500"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="HexByte" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HexCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="2,0" /></Style>
        <Style x:Key="HexHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="2,8" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="FontFamily" Value="Consolas" /></Style>
    </Window.Resources>
    <Grid x:Name="AppearanceRoot" Margin="22,20,22,0">
        <Grid.RowDefinitions><RowDefinition Height="55" /><RowDefinition Height="67" /><RowDefinition Height="43" /><RowDefinition Height="*" /><RowDefinition Height="38" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="内存查看器" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="跳转、刷新与编辑原始字节；双击字节即可修改，写入后可撤销" Style="{StaticResource MutedText}" Margin="0,4,0,0" /></StackPanel>
            <Border Grid.Column="1" CornerRadius="5" Background="{StaticResource AccentSoftBrush}" Padding="10,5" VerticalAlignment="Top" Margin="0,4,0,0"><TextBlock Text="HEX  /  ASCII" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" /></Border>
        </Grid>
        <Grid Grid.Row="1" Margin="0,12,0,15">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="270" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="起始地址" Style="{StaticResource MutedText}" Margin="0,0,12,0" />
            <TextBox Grid.Column="1" x:Name="AddressInput" FontFamily="Consolas" FontSize="14" KeyDown="AddressInput_KeyDown" ToolTip="输入十六进制地址，支持 0x 前缀" AutomationProperties.Name="内存查看器起始地址" />
            <Button Grid.Column="2" x:Name="RefreshButton" Content="读取内存" Style="{StaticResource PrimaryButton}" Click="RefreshButton_Click" Margin="9,0,0,0" />
            <StackPanel Grid.Column="4" Orientation="Horizontal"><Button x:Name="PreviousButton" Content="‹  前 1 KB" Click="PreviousButton_Click" Margin="0,0,8,0" /><Button x:Name="NextButton" Content="后 1 KB  ›" Click="NextButton_Click" /></StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button x:Name="EditByteButton" Content="编辑选中字节" Style="{StaticResource CompactButton}" Click="EditByteButton_Click" />
            <Button Grid.Column="1" x:Name="EditRowButton" Content="编辑整行 16 字节" Style="{StaticResource CompactButton}" Click="EditRowButton_Click" Margin="8,0,0,0" />
            <Button Grid.Column="2" x:Name="UndoButton" Content="撤销最近修改" Style="{StaticResource CompactButton}" Click="UndoButton_Click" Margin="8,0,0,0" />
            <CheckBox Grid.Column="3" x:Name="AutoRefreshCheck" Content="自动刷新（500 ms）" VerticalAlignment="Center" Margin="15,0,0,0" Checked="AutoRefreshCheck_Changed" Unchecked="AutoRefreshCheck_Changed" />
            <TextBlock Grid.Column="4" Text="F5 刷新 · Ctrl + Z 撤销" Style="{StaticResource MutedText}" HorizontalAlignment="Right" FontSize="11" />
        </Grid>
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="17,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="RangeLabel" Text="等待读取" Style="{StaticResource MutedText}" FontFamily="Consolas" FontSize="11" /><TextBlock Grid.Column="1" Text="16 字节 / 行 · 1 KB / 页" Style="{StaticResource MutedText}" FontSize="11" /></Grid>
                <DataGrid Grid.Row="1" x:Name="HexGrid" IsReadOnly="True" CanUserSortColumns="False" CanUserReorderColumns="False" RowHeight="27" ColumnHeaderHeight="33" CellStyle="{StaticResource HexCell}" SelectionMode="Single" SelectionUnit="Cell"
                          MouseDoubleClick="HexGrid_MouseDoubleClick" CurrentCellChanged="HexGrid_CurrentCellChanged" AutomationProperties.Name="十六进制内存内容">
                    <DataGrid.ContextMenu><ContextMenu><MenuItem Header="编辑选中字节" Click="EditByteButton_Click" /><MenuItem Header="编辑当前行 16 字节" Click="EditRowButton_Click" />
                        <Separator /><MenuItem Header="复制选中地址" Click="CopyAddress_Click" /><MenuItem Header="撤销最近修改" Click="UndoButton_Click" /></ContextMenu></DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="内存地址" Binding="{Binding Address}" Width="154" ElementStyle="{StaticResource AddressCell}" />
                        <DataGridTextColumn Header="00" Binding="{Binding Bytes[0]}" Width="31" ElementStyle="{StaticResource HexByte}" HeaderStyle="{StaticResource HexHeader}" />
                        <DataGridTextColumn Header="01" Binding="{Binding Bytes[1]}" Width="31" ElementStyle="{StaticResource HexByte}" HeaderStyle="{StaticResource HexHeader}" />
                        <DataGridTextColumn Header="02" Binding="{Binding Bytes[2]}" Width="31" ElementStyle="{StaticResource HexByte}" HeaderStyle="{StaticResource HexHeader}" />
                        <DataGridTextColumn Header="03" Binding="{Binding Bytes[3]}" Width="31" ElementStyle="{StaticResource HexByte}" HeaderStyle="{StaticResource HexHeader}" />
                        <DataGridTextColumn Header="04" Binding="{Binding Bytes[4]}" Width="31" ElementStyle="{StaticResource HexByte}" HeaderStyle="{StaticResource HexHeader}" />
                        <DataGridTextColumn Header="05" Binding="{Binding Bytes[5]}" Width="31" ElementStyle="{StaticResource HexByte}" HeaderStyle="{StaticResource HexHeader}" />
                        <DataGridTextColumn Header="06" Binding="{Binding Bytes[6]}" Width="31" ElementStyle="{StaticResource HexByte}" HeaderStyle="{StaticResource HexHeader}" />
                        <DataGridTextColumn Header="07" Binding="{Binding Bytes[7]}" Width="31" ElementStyle="{StaticResource HexByte}" HeaderStyle="{StaticResource HexHeader}" />
                        <DataGridTextColumn Header="08" Binding="{Binding Bytes[8]}" Width="31" ElementStyle="{StaticResource HexByte}" HeaderStyle="{StaticResource HexHeader}" />
                        <DataGridTextColumn Header="09" Binding="{Binding Bytes[9]}" Width="31" ElementStyle="{StaticResource HexByte}" HeaderStyle="{StaticResource HexHeader}" />
                        <DataGridTextColumn Header="0A" Binding="{Binding Bytes[10]}" Width="31" ElementStyle="{StaticResource HexByte}" HeaderStyle="{StaticResource HexHeader}" />
                        <DataGridTextColumn Header="0B" Binding="{Binding Bytes[11]}" Width="31" ElementStyle="{StaticResource HexByte}" HeaderStyle="{StaticResource HexHeader}" />
                        <DataGridTextColumn Header="0C" Binding="{Binding Bytes[12]}" Width="31" ElementStyle="{StaticResource HexByte}" HeaderStyle="{StaticResource HexHeader}" />
                        <DataGridTextColumn Header="0D" Binding="{Binding Bytes[13]}" Width="31" ElementStyle="{StaticResource HexByte}" HeaderStyle="{StaticResource HexHeader}" />
                        <DataGridTextColumn Header="0E" Binding="{Binding Bytes[14]}" Width="31" ElementStyle="{StaticResource HexByte}" HeaderStyle="{StaticResource HexHeader}" />
                        <DataGridTextColumn Header="0F" Binding="{Binding Bytes[15]}" Width="31" ElementStyle="{StaticResource HexByte}" HeaderStyle="{StaticResource HexHeader}" />
                        <DataGridTextColumn Header="ASCII" Binding="{Binding Ascii}" Width="*" MinWidth="170" ElementStyle="{StaticResource ValueCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <TextBlock Grid.Row="4" x:Name="StatusLabel" Text="等待读取内存…" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Grid>
</Window>
