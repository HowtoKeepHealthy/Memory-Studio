<Window x:Class="MemoryStudio.RecordEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Studio · 编辑记录" Width="540" SizeToContent="Height"
        MinHeight="290" MaxHeight="650" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Grid Margin="26,23,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="HeadingLabel" Text="编辑记录" FontSize="21" FontWeight="SemiBold" />
            <TextBlock x:Name="ContextLabel" Margin="0,8,0,0" Style="{StaticResource MutedText}"
                       FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" x:Name="TextPane" Margin="0,21,0,0">
            <TextBlock x:Name="FieldLabel" Text="新内容" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ContentInput" FontSize="14" TextChanged="Input_TextChanged"
                     AutomationProperties.Name="记录编辑内容" />
        </StackPanel>
        <StackPanel Grid.Row="2" x:Name="TypePane" Visibility="Collapsed" Margin="0,21,0,0">
            <TextBlock Text="数据类型" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="TypeInput" DisplayMemberPath="Label" SelectionChanged="TypeInput_SelectionChanged"
                      AutomationProperties.Name="记录数据类型" />
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="105" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="读取长度（字节）" />
                    <TextBlock x:Name="LengthHint" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,10,0" TextWrapping="Wrap" />
                </StackPanel>
                <TextBox Grid.Column="1" x:Name="ByteSizeInput" FontFamily="Consolas" MaxLength="4"
                         VerticalAlignment="Center" TextChanged="Input_TextChanged" AutomationProperties.Name="记录字节长度" />
            </Grid>
        </StackPanel>
        <TextBlock Grid.Row="3" x:Name="HintLabel" Style="{StaticResource MutedText}" Margin="0,12,0,0"
                   FontSize="11" TextWrapping="Wrap" LineHeight="19" />
        <TextBlock Grid.Row="4" x:Name="ErrorLabel" Foreground="#FFBF8A" Margin="0,10,0,0"
                   FontSize="12" TextWrapping="Wrap" MinHeight="18" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="取消" IsCancel="True" MinWidth="84" Margin="0,0,9,0" />
            <Button x:Name="SaveButton" Content="保存" IsDefault="True" MinWidth="94" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
